Project food_delivery {
  database_type: 'PostgreSQL'
}

Table users {
  id integer [primary key, increment]
  name text [not null]
  email text [unique, not null]
  password_hash text [not null]
  created_at timestamptz [default: `now()`, not null]
}

Table user_roles {
  user_id integer [not null]
  role text [note: "either customer, admin, courier", not null]
  created_at timestamptz [default: `now()`, not null]

  indexes {
    (user_id, role) [pk]
  }
}

Table restaurant_members {
  restaurant_id integer [not null]
  user_id integer [not null]
  role text [note: "either owner, manager or staff", not null]
  created_at timestamptz [default: `now()`, not null]

  indexes {
    (user_id, restaurant_id) [pk]
    restaurant_id
  }
}

Table user_addresses {
  id integer [primary key, increment]
  user_id integer [not null]
  is_default boolean [not null, default: false]
  address_line_1 varchar(255) [not null]
  address_line_2 varchar(255)
  address_line_3 varchar(255)
  postcode varchar(255) [not null]
  latitude float [not null]
  longitude float [not null]
  created_at timestamptz [default: `now()`, not null]
}

Table restaurants {
  id integer [primary key, increment]
  name text [not null]
  description varchar(255) [not null]
  cuisine_id integer [not null]
  prep_time_minutes integer [not null]
  is_paused boolean [default: false, not null]
  minimum_order_pence integer [not null]
  address_line_1 varchar(255) [not null]
  address_line_2 varchar(255)
  address_line_3 varchar(255)
  postcode text [not null]
  latitude float [not null]
  longitude float [not null]
  created_at timestamptz [default: `now()`, not null]
}

Table business_hours {
  id integer [primary key, increment]
  restaurant_id integer [not null]
  day_of_week integer [note: "sunday = 0", not null]
  opening_time time [not null]
  closing_time time [not null]
  created_at timestamptz [default: `now()`, not null]
}

Table cuisines {
  id integer [primary key, increment]
  name text [not null, unique]
  created_at timestamptz [default: `now()`, not null]
}

Table menu_categories {
  id integer [primary key, increment]
  restaurant_id integer [not null]
  name text [not null]
  sort_order integer [not null]
  created_at timestamptz [default: `now()`, not null]
}

Table menu_items {
  id integer [primary key, increment]
  menu_category_id integer [note: "menu_categories id", not null]
  name text [not null]
  description text
  price_pence integer [not null]
  is_available boolean [not null, default: true]
  sort_order integer [not null]
  created_at timestamptz [default: `now()`, not null]
}

Table menu_item_images {
  id integer [primary key, increment]
  menu_item_id integer [note: "menu item", not null]
  storage_path text [not null]
  alt_text text
  sort_order integer [not null]
  created_at timestamptz [default: `now()`, not null]
}

Table option_groups {
  id integer [primary key, increment]
  menu_item_id integer [not null]
  name text [not null]
  min_select integer [not null]
  max_select integer [not null]
  sort_order integer [not null]
  created_at timestamptz [default: `now()`, not null]
}

Table menu_item_options {
  id integer [primary key, increment]
  option_group_id integer [not null]
  name text [not null]
  price_pence integer [not null, default: 0]
  sort_order integer [not null]
  is_available boolean [not null, default: true]
  created_at timestamptz [default: `now()`, not null]
}

Table baskets {
  id integer [primary key, increment]
  customer_id integer [not null, unique]
  restaurant_id integer [not null]
  notes text
  updated_at timestamptz [not null, default: `now()`]
  created_at timestamptz [default: `now()`, not null]
}

Table basket_items {
  id integer [primary key, increment]
  basket_id integer [not null]
  menu_item_id integer [not null]
  quantity integer [not null]
  updated_at timestamptz [not null, default: `now()`]
  created_at timestamptz [default: `now()`, not null]
}

Table basket_item_options {
  basket_item_id integer [not null]
  menu_item_option_id integer [not null]
  created_at timestamptz [default: `now()`, not null]

  indexes {
    (basket_item_id, menu_item_option_id) [pk]
  }
}

Table orders {
  id integer [primary key, increment]
  customer_id integer [not null]
  restaurant_id integer [not null]
  delivery_address_line_1 varchar(255) [not null]
  delivery_address_line_2 varchar(255)
  delivery_address_line_3 varchar(255)
  delivery_postcode text [not null]
  delivery_latitude float [not null]
  delivery_longitude float [not null]
  status text [not null, default: 'pending_payment']
  subtotal_pence integer [not null]
  delivery_fee_pence integer [not null]
  service_fee_pence integer [not null]
  small_order_fee_pence integer [not null, default: 0]
  total_pence integer [not null]
  notes text
  updated_at timestamptz [not null, default: `now()`]
  created_at timestamptz [default: `now()`, not null]
}

Table order_items {
  id integer [primary key, increment]
  order_id integer [not null]
  name text [not null]
  quantity integer [not null]
  description text
  menu_item_id integer
  unit_price_pence integer [not null]
  created_at timestamptz [default: `now()`, not null]
}

Table order_item_options {
  id integer [primary key, increment]
  order_item_id integer [not null]
  option_id integer
  option_group_name text [not null]
  option_name text [not null]
  price_delta_pence integer [not null]
  created_at timestamptz [default: `now()`, not null]
}

Table order_status_events {
  id integer [primary key, increment]
  order_id integer [not null]
  from_status text [not null]
  to_status text [not null]
  changed_by_user_id integer [not null]
  created_at timestamptz [default: `now()`, not null]

  indexes {
    (order_id, created_at)
  }
}

Ref: user_roles.user_id > users.id [delete: cascade]

Ref: user_addresses.user_id > users.id [delete: cascade]

Ref: restaurant_members.user_id > users.id [delete: cascade]

Ref: cuisines.id < restaurants.cuisine_id [delete: restrict]

Ref: business_hours.restaurant_id > restaurants.id [delete: cascade]

Ref: menu_categories.restaurant_id > restaurants.id [delete: cascade]

Ref: menu_items.menu_category_id > menu_categories.id [delete: cascade]

Ref: menu_item_images.menu_item_id > menu_items.id [delete: cascade]

Ref: menu_item_options.option_group_id > option_groups.id [delete: cascade]

Ref: restaurant_members.restaurant_id > restaurants.id  [delete: cascade]

Ref: baskets.customer_id - users.id [delete: cascade]

Ref: baskets.restaurant_id > restaurants.id [delete: cascade]

Ref: basket_items.menu_item_id > menu_items.id [delete: cascade]

Ref: basket_items.basket_id > baskets.id [delete: cascade]

Ref: orders.customer_id > users.id [delete: restrict]

Ref: order_items.order_id > orders.id [delete: cascade]

Ref: orders.restaurant_id > restaurants.id [delete: restrict]

Ref: option_groups.menu_item_id > menu_items.id [delete: cascade]

Ref: basket_item_options.basket_item_id > basket_items.id [delete: cascade]

Ref: basket_item_options.menu_item_option_id > menu_item_options.id [delete: cascade]

Ref: order_item_options.order_item_id > order_items.id [delete: cascade]

Ref: order_item_options.option_id > menu_item_options.id [delete: set null]

Ref: order_items.menu_item_id > menu_items.id [delete: set null]

Ref: order_status_events.id > orders.id [delete: cascade]

Ref: order_status_events.changed_by_user_id > users.id [delete: set null]